# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# uv
uv.lock

# pytest
.pytest_cache/
# --basetemp lands here; the suffixed forms are what you reach for when a
# previous run still holds a lock on the plain one, so ignore those too.
.pytest-tmp*/
.tmp-pytest/

# cflow run state (per-directory, machine-local)
.cflow/

# OS
.DS_Store
Thumbs.db

# bv (beads viewer) local config and caches
.bv/

# Per-machine MCP entry: cmd /c on Windows, plain `claunch mcp` elsewhere.
# `claunch install` writes it (install.mcp_server_def); a tracked copy is
# wrong on one of the two OSes (claunch-393jv).
/.mcp.json

# Launcher worktrees (worktree.WORKTREES_SUBDIR). Each holds a `.git` file, so
# git lists the directory as untracked and daemon/runtime_state counts it as
# code in no commit -- tools/deploy_check.py then exits 3 (claunch-6pcyo).
/.claude/worktrees/
